<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0011-create-password-reset-token-table" author="Andrii">
        <createTable tableName="password_reset_token">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_password_reset_token"/>
            </column>

            <column name="user_id" type="BIGINT">
                <!-- Зверніть увагу: якщо ваша таблиця користувачів називається "user" (а не "users"), змініть атрибут references -->
                <constraints nullable="false" foreignKeyName="fk_password_reset_user" references="users(id)"/>
            </column>

            <column name="expiry_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>