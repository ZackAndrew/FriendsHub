<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="refactor-meetings-to-group" author="Andrii Zakordonskyi">

        <createTable tableName="meeting_participants">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="meeting_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_mp_meeting" references="meeting(id)"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_mp_user" references="users(id)"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            INSERT INTO meeting_participants (meeting_id, user_id, status, role)
            SELECT id, organizer_id, 'ACCEPTED', 'ORGANIZER'
            FROM meeting;
        </sql>

        <sql>
            INSERT INTO meeting_participants (meeting_id, user_id, status, role)
            SELECT id, participant_id, status, 'GUEST'
            FROM meeting
            WHERE participant_id IS NOT NULL;
        </sql>

        <dropForeignKeyConstraint baseTableName="meeting" constraintName="fk_meeting_participant"/>

        <dropColumn tableName="meeting" columnName="participant_id"/>
        <dropColumn tableName="meeting" columnName="status"/>

    </changeSet>
</databaseChangeLog>