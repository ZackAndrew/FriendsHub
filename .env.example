# Database Configuration
DB_NAME=friendshub_db
DATASOURCE_URL=jdbc:postgresql://db:5432/friendshub_db
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=postgres

# Server Port
SERVER_PORT=8060

# JWT Security
JWT_SECRET=your-256-bit-secret-key-here

# Mail (Google App Password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password

# Google OAuth2
OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=FriendsHubBot

# Frontend URL
FRONTEND_URL=http://localhost:5173
